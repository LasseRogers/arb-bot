[Unit]
Description=arb-bot gold: paper trading PAXG vs XAUUSD
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
WorkingDirectory=%h/projects/arb-bot
ExecStart=%h/projects/arb-bot/venv/bin/python -m arbbot.gap.live
Environment=PYTHONUNBUFFERED=1
# Stop like Ctrl+C, so the bot saves its state and flushes recorded quotes.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
